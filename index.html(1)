<script>
(function(){
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- scroll-linked background color ----
  var stops = [
    {r:11,  g:14,  b:46},   // navy-deep   (hero / about)
    {r:23,  g:27,  b:69},   // navy-mid    (profile)
    {r:59,  g:42,  b:107},  // violet      (menu)
    {r:44,  g:30,  b:40}    // warm dusk   (reserve / footer)
  ];

  function lerp(a,b,t){ return a + (b-a)*t; }

  function updateBg(){
    var doc = document.documentElement;
    var scrollTop = window.scrollY;
    var max = doc.scrollHeight - window.innerHeight;
    var p = max > 0 ? scrollTop / max : 0;
    var segs = stops.length - 1;
    var segF = p * segs;
    var i = Math.min(Math.floor(segF), segs - 1);
    var t = segF - i;
    var a = stops[i], b = stops[i+1];
    var r = Math.round(lerp(a.r,b.r,t));
    var g = Math.round(lerp(a.g,b.g,t));
    var bl = Math.round(lerp(a.b,b.b,t));
    document.body.style.backgroundColor = 'rgb(' + r + ',' + g + ',' + bl + ')';
  }

  var ticking = false;
  window.addEventListener('scroll', function(){
    if(!ticking){
      requestAnimationFrame(function(){ updateBg(); ticking = false; });
      ticking = true;
    }
  }, {passive:true});
  updateBg();

  // ---- click / tap ripple ----
  if(!reduceMotion){
    document.addEventListener('pointerdown', function(e){
      var r = document.createElement('span');
      r.className = 'ripple';
      var size = Math.max(window.innerWidth, window.innerHeight) * 1.1;
      r.style.left = e.clientX + 'px';
      r.style.top = e.clientY + 'px';
      r.style.width = size + 'px';
      r.style.height = size + 'px';
      document.body.appendChild(r);
      r.addEventListener('animationend', function(){ r.remove(); });
    });
  }
})();
</script>

